{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nleft_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nright_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nmotor_arm = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\nmotor_claw = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       SJH Robotics 2025/2026\n#\tCreated:\n#\tDescription:  VEXcode V5(EDR) Python\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n# Begin project code\nwhile True:\n\n   #axis3pos\n    if controller.axis3.position() >=-1 and controller_1,axis3.position() <= 1:\n        x = True\n\n        else:\n            x = False\n\n\n    #axis4pos\n    if controller_1.axis4.position() >= -1 and controller_1.axis4.position() <= 1:\n        y = True\n\n        else:\n            y = False\n\n\n\n    #axis1pos\n    if controller_1.axis1.position() >= -1 and controller_1.axis1.position() <= 1:\n        z = True\n\n        else:\n            z = False\n\n\n    #axis2pos\n    if controller_1.axis2.position() >= -1 and controller_1.axis2.position() <= 1:\n        a = True\n\n        else:\n            a = False\n\n    #forward/backward\n    if x = False:\n        left_motor.set_velocity(controller_1.axis3.position(),PERCENT)\n        right_motor.set_velocity(controller_1.axis3.position(),PERCENT)\n\n    #turn\n    elif x = True and y = False:\n        if controller_1.axis4.position() >= 1:\n            left_motor.set_velocity(controller_1.axis4.position() +50,PERCENT)\n            right_motor.set_velocity(controller_1.axis4.position() -50,PERCENT)\n\n        if controller_1.axis4.position() <= -1:\n            left_motor.set_velocity(controller_1.axis4.position() *-1 -50,PERCENT)\n            right_motor.set_velocity(controller_1.axis4.position() *-1 +50,PERCENT)\n    #arm\n    if z = False:\n        motor_arm.set_velocity(controller_1.axis1.position(),PERCENT)\n        else:\n            motor_arm.set_stopping(HOLD)\n\n    #claw\n    if a = False:\n        if controller_1.axis2.position() >= 1:\n            motor_claw.spin_to_position(90,DEGREES,wait=False)\n        elif controller_1.axis2.position() <=-1:\n            motor_claw.spin_to_position(-90,DEGREES,wait=False)\n\n\n    def R1():\n        motor_arm.set_stopping(BRAKE)\n        motor_claw.set_stopping(BRAKE)\n        left_motor.set_stopping(BRAKE)\n        right_motor.set_stopping(BRAKE)\n        left_motor.spin_for(FORWARD,5,TURNS,wait=False)\n        right_motor.spin_for(REVERSE, 5,TURNS,wait=False)\n\n\n    def L1():\n        motor_arm.set_stopping(BRAKE)\n        motor_claw.set_stopping(BRAKE)\n        left_motor.set_stopping(BRAKE)\n        right_motor.set_stopping(BRAKE)\n        left_motor.spin_for(REVERSE,5,TURNS,wait=False)\n        right_motor.spin_for(FORWARD, 5,TURNS,wait=False)\n\n\n\n    controller_1.buttonR1.pressed(R1)\n    controller_1.buttonL1.pressed(L1)\n        \n\n    def battery_voltage_check():\n        controller_1.screen.print(brain.battery.voltage(VoltageUnits.VOLT))\n\n    def battery_current_check():\n        controller_1.screen.print(brain.battery.current(CurrentUnits.AMP))\n    \n    \n    def battery_capacity_check():\n        controller_1.screen.print(brain.battery.capacity())\n\n\n\n    controller_1.buttonUp.pressed(battery_voltage_check)\n    controller_1.buttonLeft.pressed(battery_current_check)\n    controller_1.buttonRight.pressed(battery_capacity_check)\n\n    if controller_1.buttonDown.pressing():\n        controller_1.screen.clear_screen()\n        brain.screen.clear_screen()\n\n\n\n    def emergency_stop:\n        motor_arm.set_stopping(BRAKE)\n        motor_claw.set_stopping(BRAKE)\n        left_motor.set_stopping(BRAKE)\n        right_motor.set_stopping(BRAKE)\n        controller_1.rumble(\".-.-\")\n        controller_1.screen.print(\"EMERGENCY STOP\")\n        brain.screen.print(\"EMERGENCY STOP\")\n\n\n    def hold_all:\n        motor_arm.set_stopping(HOLD)\n        motor_claw.set_stopping(HOLD)\n        left_motor.set_stopping(HOLD)\n        right_motor.set_stopping(HOLD)\n        controller_1.rumble(\"-.-.\")\n        controller_1.screen.print(\"HOLD POSITION\")\n        brain.screen.print(\"HOLD POSITION\")\n\n    controller_1.buttonR2.pressed(emergency_stop)\n    controller_1.buttonL2.pressed(hold_all)\n\n    #idle\n    if x = True and y = True and z = True and x = True:\n        controller.screen.print (\"No Input Detected\")\n        brain.screen.print(\"Idle\")\n        \n        else brain.screen.clear_screen\n\n\n\n    #shutdown\n    if controller_1.buttonL1.pressing() and controller_1.buttonL2.pressing() and controller_1.buttonR1.pressing() and controller_1.buttonR2.pressing():\n        controller_1.screen.print (\"EMERGENCY SHUTDOWN\")\n        controller_1.rumble (\"---...---\")\n        brain.screen.print (\"EMERGENCY SHUTDOWN\")\n        brain.program_stop()\n    \n\n\n    left_motor.spin(FORWARD)\n    right_motor.spin(FORWARD)\n\n\n\n    wait(20,MSEC)","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[1],"name":"left_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[2],"name":"right_motor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[3],"name":"motor_arm","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[4],"name":"motor_claw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}